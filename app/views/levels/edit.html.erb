<%= form_with url: levels_update_path, method: :patch, local: true do |form| %>
    <div class="max-h-[75vh] overflow-y-auto px-4 pb-4">
        <div class="grid grid-cols-1 justify-items-center mt-8">
        <% @count = 1 %>
    
        <% if @prev_levels >= @levels %>
            <% @levels.times do %>
            <% level = @game.levels[@count - 1] %>
            <div class="mt-6 mb-4">
                <%= form.label :level, "Level #{@count}:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.label :sb, "Small Blind:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "sb#{@count}", in: 100..10000000, step: 100, value: level&.sb || 100 * @count, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :bb, "Big Blind:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "bb#{@count}", in: 100..10000000, step: 100, value: level&.bb || 200 * @count, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :ante, "Ante:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "ante#{@count}", in: 0..10000000, step: 100, value: level&.ante || 0, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :length, "Round Length:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "length#{@count}", in: 10..120, step: 5, value: level&.length || @game.round_length, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :break, "Break After Level?", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.check_box "break#{@count}", { checked: level&.break, class: @game.league.present? ? "leagues_form_checkbox" : "games_form_checkbox" }, "1", "0" %>

                <%= form.label :break_length, "Break Length:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "break_length#{@count}", in: 0..120, step: 5, value: level&.break_length || 0, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
            </div>
            <% @count += 1 %>
            <% end %>
        <% else %>
            <% # Render existing levels %>
            <% @prev_levels.times do %>
            <% level = @game.levels[@count - 1] %>
            <div class="mt-6 mb-4">
                <%= form.label :level, "Level #{@count}:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.label :sb, "Small Blind:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "sb#{@count}", in: 100..10000000, step: 100, value: level&.sb || 100 * @count, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :bb, "Big Blind:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "bb#{@count}", in: 100..10000000, step: 100, value: level&.bb || 200 * @count, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :ante, "Ante:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "ante#{@count}", in: 0..10000000, step: 100, value: level&.ante || 0, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :length, "Round Length:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "length#{@count}", in: 10..120, step: 5, value: level&.length || @game.round_length, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :break, "Break After Level?", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.check_box "break#{@count}", { checked: level&.break, class: @game.league.present? ? "leagues_form_checkbox" : "games_form_checkbox" }, "1", "0" %>

                <%= form.label :break_length, "Break Length:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "break_length#{@count}", in: 0..120, step: 5, value: level&.break_length || 0, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
            </div>
            <% @count += 1 %>
            <% end %>
    
            <% count = 1 %>
            <% @new_levels.times do %>
            <div class="mt-6 mb-4">
                <%= form.label :level, "Level #{@count}:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.label :sb, "Small Blind:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "sb#{@count}", in: 100..10000000, step: 100, value: 100 * @count, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :bb, "Big Blind:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "bb#{@count}", in: 100..10000000, step: 100, value: 200 * @count, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :ante, "Ante:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "ante#{@count}", in: 0..10000000, step: 100, value: 0, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :length, "Round Length:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "length#{@count}", in: 10..120, step: 5, value: @game.round_length, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
                
                <%= form.label :break, "Break After Level?", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.check_box "break#{@count}", type: "checkbox", class: @game.league.present? ? "leagues_form_checkbox" : "games_form_checkbox" %>

                <%= form.label :break_length, "Break Length:", class: @game.league.present? ? "leagues_form_labels" : "game_form_labels" %>
                <%= form.number_field "break_length#{@count}", in: 0..120, step: 5, value: 0, class: @game.league.present? ? "leagues_number_field" : "blind_field" %>
            </div>
            <% @count += 1 %>
            <% count += 1 %>
            <% end %>
        <% end %>
    
        <div>
            <%= form.hidden_field :id, value: @game.id %>
            <% if @game.league.present? %>
                <%= form.hidden_field :league_id, value: @game.league.id %>
            <% end %>
        </div>
        </div>
    </div>
    <div class="sticky bottom-0 bg-zinc-800 py-4 mt-4 flex justify-center z-10">
        <%= form.submit "Submit", name: nil, class: @game.league.present? ? "leagues_submit_button" : "single_game_submit_button" %>
    </div>
<% end %>