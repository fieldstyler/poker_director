<div class="game_show_page_container">
  <div class="relative w-full h-20 bg-zinc-800 flex items-center justify-center">
    <div class="leagues_index_title text-center pb-4">Current Leagues</div>

    <div class="absolute left-8 top-1/2 -translate-y-1/2">
      <%= link_to "Add New League", new_league_path, class: "leagues_button" %>
    </div>

  </div>

  <div class="game_players_containers">
    <div class="flex flex-col w-full">

      <table class="table-auto w-full text-emerald-300 font-bold text-center">
        <thead>
          <tr class="border-b border-emerald-200">
            <th class="text-xl p-4">League Name</th>
            <th class="text-xl p-4">Sessions</th>
            <th class="text-xl p-4">Players</th>
            <th class="text-xl p-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @leagues.each do |league| %>
            <tr class="border-b border-emerald-200 hover:bg-emerald-900/30">
              <td class="p-4">
                <%= link_to league.name, league_path(league), class: "underline text-emerald-400 hover:text-emerald-100" %>
              </td>
              <td class="text-emerald-400 p-4"><%= league.number_of_sessions %></td>
              <td class="text-emerald-400 p-4"><%= league.players.count %></td>
              <td class="text-emerald-400 p-4 space-x-2">
                <%= link_to edit_league_path(league), class: "league_edit_button" do %>
                  <%= heroicon "pencil-square", title: "Edit", type: "outline", class: "w-4 h-4" %>
                <% end %>
                <%= link_to league_path(league), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-flex items-center justify-center w-8 h-8 bg-red-200 text-black rounded-full hover:bg-red-400" do %>
                  <%= heroicon "trash", title: "Delete", type: "outline", class: "w-4 h-4" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
