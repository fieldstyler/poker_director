<%= form_with(model: @game, url: @game.league.present? ? edit_league_game_path(@game.league, @game) : update_game_path(@game), method: :patch, local: true) do |form| %>
    <div class="grid grid-cols-1 justify-items-center mt-8">
        <div class="mt-6 mb-4">
            <%= form.label :player_count, "Players: ", class: "game_form_labels" %>
            <%= form.number_field :player_count, in: 0..10000, step: 1, value: @game.player_count, class: "text_field" %>
        </div>
        <div class="mt-6 mb-4">
            <%= form.label :buy_in, "Buy-In: ", class: "game_form_labels" %>
            <%= form.number_field :buy_in, in: 0..10000, step: 10, value: @game.buy_in, class: "text_field" %>
        </div>
        <div class="mt-4 mb-4">
            <%= form.label :starting_stack, "Starting Stack: ", class: "game_form_labels" %>
            <%= form.number_field :starting_stack, in: 5000..1000000, step: 5000, value: @game.starting_stack, class: "text_field" %>
        </div>
        <div class="mt-4 mb-4">
            <%= form.label :round_length, "Round Length: ", class: "game_form_labels" %>
            <%= form.number_field :round_length, in: 10..120, step: 10, value: @game.round_length, class: "text_field" %>
        </div>
        <div class="mt-4 mb-4">
            <%= form.label :places_paid, "Places Paid: ", class: "game_form_labels" %>
            <%= form.number_field :places_paid, value: @game.places_paid, class: "text_field" %>
        </div>
        <% if 1 == 2 %>
            <% if @game.knockouts == true %>
                <div class="mt-4 mb-4">
                    <%= form.label :knockouts, "Knockouts?", class: "game_form_labels" %>
                    <%= form.checkbox :knockouts, type: "checkbox", checked: true, class: "games_form_checkbox" %>
                </div>
            <% else %>
                <div class="mt-4 mb-4">
                    <%= form.label :knockouts, "Knockouts?", class: "game_form_labels" %>
                    <%= form.checkbox :knockouts, type: "checkbox", class: "games_form_checkbox" %>
                </div>
            <% end %>
            <% if @game.rebuys == true %>
                <div class="mt-4 mb-4">
                    <%= form.label :rebuys, "Rebuys?", class: "game_form_labels" %>
                    <%= form.checkbox :rebuys, type: "checkbox", checked: true, class: "games_form_checkbox" %>
                </div>
            <% else %>
                <div class="mt-4 mb-4">
                    <%= form.label :rebuys, "Rebuys?", class: "game_form_labels" %>
                    <%= form.checkbox :rebuys, type: "checkbox", class: "games_form_checkbox" %>
                </div>
            <% end %>
        <% end %>
        <div class="mt-4 mb-4">
            <%= form.label :level_count, "How Many Levels? ", class: "game_form_labels" %>
            <%= form.number_field :level_count, value: @game.level_count, class: "text_field" %>
        </div>
        <div class="mt-4 mb-4">
            <%= form.submit "Submit", name: nil, class: "single_game_submit_button" %>
        </div>
    </div>
<% end %>
